# Copy this file to ".env" and fill in your own values. Never commit .env to GitHub.
GCP_PROJECT_ID=your-project-id
BQ_DATASET=air_quality
BQ_TABLE=daily_air_quality
BQ_LOCATION=US

# Required. The name of the Cloud Storage bucket you created. The raw data, the job code and the results live here.
GCS_BUCKET=

# The region where the Dataproc job runs, for example us-central1.
DATAPROC_REGION=us-central1

# The Dataproc Serverless runtime version (a Spark version). 2.3 is a long-term-support version.
DATAPROC_RUNTIME_VERSION=2.3
